    "preCompact": [{ "command": "align-agent-hook cursor" }],
    "subagentStart": [{ "command": "align-agent-hook cursor" }],
    "beforeShellExecution": [{ "command": "align-agent-hook cursor" }],
    "beforeReadFile": [{ "command": "align-agent-hook cursor" }],
